    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
